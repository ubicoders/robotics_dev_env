# Pinned versions for every image. Plain KEY=VALUE lines only.

# Base OS
UBUNTU_VERSION=24.04
UBUNTU_CODENAME=noble

# Miniconda, Python 3.12
MINICONDA_INSTALLER=Miniconda3-py312_26.7.1-1-Linux-x86_64.sh

# PX4 toolchain
PX4_TOOLCHAIN_VERSION=v1.17.0
# Use v2.4.3 for stock PX4 v1.17.0 firmware
UXRCE_DDS_AGENT_VERSION=v3.0.2
# Must match the PX4 firmware release
PX4_MSGS_VERSION=release/1.17
EMPY_VERSION=3.3.4

# ROS 2
ROS_DISTRO=jazzy

# Rust for ROS 2: rclrs (ros2_rust) and r2r
RUST_VERSION=1.98.1
ROS2_RUST_VERSION=v0.7.0
R2R_VERSION=0.9.7
CARGO_AMENT_BUILD_VERSION=0.1.11
COLCON_CARGO_VERSION=0.2.0
COLCON_ROS_CARGO_VERSION=0.2.0
# Release tags that match rclrs 0.7.0. rosidl_rust 0.5.0 changed the message scheme.
ROSIDL_RUST_VERSION=0.4.12
ROSIDL_RUNTIME_RS_VERSION=v0.6.1

# CUDA
CUDA_VERSION=12.8.1

# OpenCV
OPENCV_VERSION=4.12.0
OPENCV_PYTHON_VERSION=4.12.0.88

# ZED SDK, file in images/cuda/ocv_zed/zed_sdk/
ZED_PYTHON_VERSION=3.10
ZED_SDK_INSTALLER=ZED_SDK_Ubuntu24_cuda12.8_tensorrt10.9_v5.0.5.zstd.run
