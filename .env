# Single source of truth for every pinned version used by the images.
# Read automatically by `docker compose`, which build.bash drives for both build and push.
# Keep plain KEY=VALUE lines (no quotes, no spaces).

# --------------------
# Base OS
# --------------------
UBUNTU_VERSION=24.04
UBUNTU_CODENAME=noble

# --------------------
# Python (Miniconda)
# --------------------
# Pinned installer from https://repo.anaconda.com/miniconda/. Do not use
# Miniconda3-latest: it moved to Python 3.14, for which ubicoders-g2opy has no
# wheels. Python 3.12 also matches the Ubuntu 24.04 / ROS 2 Jazzy system Python.
MINICONDA_INSTALLER=Miniconda3-py312_26.7.1-1-Linux-x86_64.sh

# --------------------
# PX4 (toolchain only)
# --------------------
# Tag of PX4-Autopilot whose Tools/setup/ubuntu.sh and requirements.txt install
# the build toolchain. The PX4 source is NOT kept in the image: users clone
# their own PX4 repository (any version or fork) inside the container.
PX4_TOOLCHAIN_VERSION=v1.17.0
# Micro XRCE-DDS Agent: v3.0.2 is the latest upstream release.
# WARNING: agent v3.x is not wire-compatible with the 2.x client in stock PX4
# v1.17.0 firmware. It requires firmware built with UXRCE_DDS_CLIENT_USE_DDS_V3,
# a Kconfig option that exists only on PX4 main. For stock v1.17.0 firmware with
# ROS 2 Jazzy, set this back to v2.4.3 (the version the PX4 docs prescribe).
UXRCE_DDS_AGENT_VERSION=v3.0.2
# px4_msgs must match the firmware release, or uORB and ROS 2 topics mismatch.
PX4_MSGS_VERSION=release/1.17
EMPY_VERSION=3.3.4

# --------------------
# ROS 2
# --------------------
# Base image: osrf/ros:${ROS_DISTRO}-desktop-full-${UBUNTU_CODENAME}
ROS_DISTRO=jazzy

# --------------------
# CUDA
# --------------------
# Base image: nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu${UBUNTU_VERSION}
CUDA_VERSION=12.8.1

# --------------------
# Vision (OpenCV, ZED)
# --------------------
OPENCV_VERSION=4.12.0
OPENCV_PYTHON_VERSION=4.12.0.88
ZED_PYTHON_VERSION=3.10
# Installer file must exist in images/cuda/ocv_zed/ (ignored by git). Its name encodes
# the ZED SDK, CUDA, and TensorRT versions, so it must agree with CUDA_VERSION.
ZED_SDK_INSTALLER=ZED_SDK_Ubuntu24_cuda12.8_tensorrt10.9_v5.0.5.zstd.run
